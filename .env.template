# API Endpoint URL (default: OpenAI chat completions)
# Examples for local OpenAI-compatible servers:
# - LM Studio: http://localhost:1234/v1/chat/completions
# - Ollama:    http://localhost:11434/v1/chat/completions
# - vLLM:      http://localhost:8000/v1/chat/completions
ZSH_COPILOT_API_URL=https://api.openai.com/v1/chat/completions

# Model identifier (e.g., gpt-4o, gpt-3.5-turbo, or your loaded local model name)
ZSH_COPILOT_MODEL=gpt-3.5-turbo

# Maximum tokens for output generation
ZSH_COPILOT_TOKENS=1000

# API Key (required for OpenAI; can be any dummy value like "not-needed" for local servers)
ZSH_COPILOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shortcuts
ZSH_COPILOT_SHORTCUT_PREDICT=^k^p
ZSH_COPILOT_SHORTCUT_ASK=^k^a
ZSH_COPILOT_SHORTCUT_FIX=^k^f
